# 把这个文件复制成 .env，填入你自己的 key

# ── 必填 ──────────────────────────────────────────────────────────────────────
# 新闻检索（app.tavily.com）
TAVILY_API_KEY=tvly-dev-xxxxxxxxxxxxxxxxxxxxxxxx

# 全部 AI 调用的后端（console.anthropic.com，用户自己的 key、自担费用）。
# 缺它会回落到旧课堂网关 CLASSROOM_API_KEY，而该网关域名 2026-07-08 起已 NXDOMAIN
# —— 也就是说不填这个，任何未缓存的钱包都出不了板。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ── 可选 ──────────────────────────────────────────────────────────────────────
# 数据层默认走 Polymarket 免费公开 API（Data API v2 / Gamma / CLOB，免 key，fetcher/pm_backend.py）。
# 只有拿到付费 Heisenberg key 时才设 DATA_BACKEND=heisenberg + HEISENBERG_API_KEY。
# DATA_BACKEND=heisenberg
# HEISENBERG_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# GitHub 状态持久层（core/persist.py）：把刷新过的推荐榜/看板缓存/记分牌存回
# app-state 分支，跨部署与冷启动不丢。fine-grained PAT，只需本仓库 Contents 读写。
# 不填则静默跳过保存（恢复端读公开 raw，本来就不需要 token）。
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# 跨实例防止同一推荐榜/钱包看板重复跑 AI；未配置时自动回退单进程协调
REDIS_URL=redis://default:password@host:6379

# 旧课堂网关回落位。其默认域名 2026-07-08 起已 NXDOMAIN，除非老师重新部署并配
# GATEWAY_URL，否则填了也没用 —— 有 ANTHROPIC_API_KEY 就不需要它。
# CLASSROOM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
